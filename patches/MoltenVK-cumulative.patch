+static uint64_t mvkStableMSLHash(const string& source) {
+	uint64_t hash = 1469598103934665603ull;
+	for (unsigned char byte : source) {
+		hash ^= byte;
+		hash *= 1099511628211ull;
+	}
+	return hash;
