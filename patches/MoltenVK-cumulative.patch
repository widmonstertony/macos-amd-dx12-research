@@ -0,0 +1,15 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+
+// Preserve pointer identity/equality while distributing aligned addresses over
+// power-of-two bucket counts (libc++ uses them after reserve(1024)).
+template<class Pointer> struct MVKPointerHash {
+    std::size_t operator()(Pointer pointer) const noexcept {
+        uint64_t x = std::hash<Pointer>{}(pointer);
+        x ^= x >> 30; x *= UINT64_C(0xbf58476d1ce4e5b9);
+        x ^= x >> 27; x *= UINT64_C(0x94d049bb133111eb);
+        return x ^ (x >> 31);
+    }
+};
diff -ruN --exclude=include --exclude=SPIRV-Cross --exclude=SPIRV-Tools --exclude=Tools /tmp/mvk-upstream-patchcheck/MoltenVK-05604465d691118cfd20f53a48ecf1aad9c12f93/MoltenVK/MoltenVK/Commands/MVKStableUseMap.h workspace/open-game-stack-20261015/native-vendor/MoltenVK-05604465d691118cfd20f53a48ecf1aad9c12f93/MoltenVK/MoltenVK/Commands/MVKStableUseMap.h
--- a/MoltenVK/MoltenVK/Commands/MVKStableUseMap.h	1969-12-31 16:00:00
+++ b/MoltenVK/MoltenVK/Commands/MVKStableUseMap.h	2026-10-22 22:18:47
@@ -0,0 +1,77 @@
+// Append-only CPU map for encoder resource-use state. Deque values keep stable
+// addresses for the recent-resource cache while the flat index can grow.
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <utility>
+#include <vector>
+
+template<class Key, class Value> class MVKStableUseMap {
+    struct Slot { Key key{}; std::size_t indexPlusOne = 0; };
+    using Entries = std::deque<std::pair<Key, Value>>;
+    Entries entries;
+    std::vector<Slot> slots;
+    void rehash(std::size_t capacity) {
+        slots.assign(capacity, Slot{});
+        for (std::size_t n=0;n<entries.size();++n) {
+            auto i=std::hash<Key>{}(entries[n].first)&(capacity-1);
+            while(slots[i].indexPlusOne)i=(i+1)&(capacity-1);
+            slots[i]={entries[n].first,n+1};
+        }
+    }
+public:
+    using iterator=typename Entries::iterator;
+    void reserve(std::size_t count) {
+        if(count<=slots.size()/2)return;
+        std::size_t capacity=16;
+        while(capacity/2<count)capacity*=2;
+        if(capacity>slots.size())rehash(capacity);
+    }
+    iterator begin() { return entries.begin(); }
+    iterator end() { return entries.end(); }
+    std::size_t size() const { return entries.size(); }
+    iterator find(Key key) {
+        if(slots.empty())return end();
+        auto i=std::hash<Key>{}(key)&(slots.size()-1);
+        while(slots[i].indexPlusOne) {
+            if(slots[i].key==key)return entries.begin()+slots[i].indexPlusOne-1;
+            i=(i+1)&(slots.size()-1);
+        }
+        return end();
+    }
+    // Hot resource-binding paths only need the mapped value. Returning it
+    // directly avoids reconstructing a deque iterator (and its segmented
+    // index calculation) after every successful hash-table probe.
+    Value* findValue(Key key) {
+        if(slots.empty())return nullptr;
+        auto i=std::hash<Key>{}(key)&(slots.size()-1);
+        while(slots[i].indexPlusOne) {
+            if(slots[i].key==key)return &entries[slots[i].indexPlusOne-1].second;
+            i=(i+1)&(slots.size()-1);
+        }
+        return nullptr;
+    }
+    std::pair<iterator,bool> emplace(Key key, const Value& value) {
+        if(slots.empty())reserve(1);
+        auto i=std::hash<Key>{}(key)&(slots.size()-1);
+        while(slots[i].indexPlusOne) {
+            if(slots[i].key==key)return {entries.begin()+slots[i].indexPlusOne-1,false};
+            i=(i+1)&(slots.size()-1);
+        }
+        if(entries.size()+1>slots.size()/2) {
+            reserve(entries.size()+1);
+            i=std::hash<Key>{}(key)&(slots.size()-1);
+            while(slots[i].indexPlusOne)i=(i+1)&(slots.size()-1);
+        }
+        entries.emplace_back(key,value);
+        slots[i]={key,entries.size()};
+        return {entries.end()-1,true};
+    }
+    void clear() {
+        entries.clear();
+        std::fill(slots.begin(),slots.end(),Slot{});
+    }
+};
