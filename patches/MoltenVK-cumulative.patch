+static void bindGeometryXfb(MVKCommandEncoder* cmdEncoder, MVKGraphicsPipeline* pipeline, uint32_t mode,
+							const MVKMTLBufferAllocation* prims) {
+	if ( !pipeline->usesGeometryXfb() ) { return; }
