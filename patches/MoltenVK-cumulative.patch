+	auto append = [&](size_t lineNum, string_view text) {
+		out += "[mvk-msl] ";
+		if (lineNum) {
+			out += to_string(lineNum);
+			out += ": ";
+		}
+		if (text.size() > kMaxLineLength) {
+			out.append(text.substr(0, kMaxLineLength));
+			out += " [...]";
+		} else {
