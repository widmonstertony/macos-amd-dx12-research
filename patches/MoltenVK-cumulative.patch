+void MVKUseResourceHelper::releaseLiveResources() {
+    publishResourceUseStats(false);
+    declaredSnapshots.clear(); snapshotLiveIdentities=0;
+	releasePendingBatchLiveResources();
+	if (traceLiveCache && (liveLookupCount || liveReuseCount)) {
+		fprintf(stderr, "MVK_LIVE_CACHE enabled=%u lookups=%llu reused=%llu retained=%zu\n",
+		        cacheLiveResources, (unsigned long long)liveLookupCount, (unsigned long long)liveReuseCount, retainedLiveResources.size());
+		if (!recentLiveResources.empty()) fprintf(stderr, "MVK_LIVE_RECENT retainedHits=%llu absentHits=%llu\n", (unsigned long long)liveRecentReuseCount, (unsigned long long)liveAbsentReuseCount);
+		liveLookupCount = liveReuseCount = 0;
+		liveRecentReuseCount = liveAbsentReuseCount = 0;
+	}
+	// ResourceInfo pointers remain stable across unordered_map rehash, but not
+	// across the encoder's used.clear(). Never carry them into another encoder.
+	for (auto& recent : recentLiveResources) recent = {};
+	absentLiveResources.clear();
+	for (id<MTLResource> resource : retainedLiveResources) [resource release];
+	retainedLiveResources.clear();
+    retainedSnapshotLeases.clear();
+}
+
+void MVKUseResourceHelper::releasePendingBatchLiveResources() {
+	for (id<MTLResource> resource : pendingBatchLiveResources) [resource release];
+	pendingBatchLiveResources.clear();
+}
+
+void MVKUseResourceHelper::resetForEncoder() {
+	// Record the helper's parsed values, rather than inferring them from the
+	// Steam launch client's environment. A running Steam can inherit different
+	// values from those supplied to a later -applaunch request.
+	static const char* configPath = getenv("MVK_AMD_EFFECTIVE_CONFIG_PATH");
+	static std::atomic_flag configWritten = ATOMIC_FLAG_INIT;
+	if (configPath && !configWritten.test_and_set()) {
+		FILE* file = fopen(configPath, "w");
+		if (file) {
+			fprintf(file, "{\"pid\":%d,\"encoderLiveCache\":%u,\"crossEncoderLiveCache\":%u,\"recentCacheSlots\":%zu,\"batchLiveResources\":%u,\"batchArgumentHeaps\":%u,\"heapThreshold\":%u,\"descriptorSnapshotReuse\":%u,\"negativeLiveCache\":%u,\"crossEncoderSnapshotReuse\":%u}\n",
+			        getpid(),cacheLiveResources,crossEncoderLiveCache,recentLiveResources.size(),batchLiveResources,batchArgumentHeaps,heapBatchThreshold,descriptorSnapshotReuse,negativeLiveCache,crossEncoderSnapshotReuse);
+			fclose(file);
+		}
+	}
+	publishResourceUseStats(true);
+	if (!crossEncoderSnapshotReuse) { declaredSnapshots.clear(); snapshotLiveIdentities=0; }
+	releasePendingBatchLiveResources();
+	// Direct-map entries contain ResourceInfo pointers. Clear them at every
+	// encoder boundary so the new encoder always receives its own useResource
+	// declaration, while optionally retaining the validated Metal objects for
+	// the duration of this command submission.
+	for (auto& recent : recentLiveResources) recent = {};
+	if (!crossEncoderLiveCache) releaseLiveResources();
+	// Mark retained map nodes stale instead of freeing and reallocating every
+	// time Vulkan command encoding switches between Metal render and compute.
+	// Bound long-lived command buffers conservatively; clearing here affects CPU
+	// bookkeeping only and never skips a liveness validation.
+	if (++encoderGeneration == 0 || used.size() > 8192) {
+		if (crossEncoderLiveCache) releaseLiveResources();
+		used.clear();
+		encoderGeneration = 1;
+	}
+}
