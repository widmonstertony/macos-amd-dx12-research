+void MVKUseResourceHelper::releaseLiveResources() {
+	releasePendingBatchLiveResources();
+	if (traceLiveCache && (liveLookupCount || liveReuseCount)) {
+		fprintf(stderr, "MVK_LIVE_CACHE enabled=%u lookups=%llu reused=%llu retained=%zu\n",
+		        cacheLiveResources, (unsigned long long)liveLookupCount, (unsigned long long)liveReuseCount, retainedLiveResources.size());
+		if (!recentLiveResources.empty()) fprintf(stderr, "MVK_LIVE_RECENT retainedHits=%llu absentHits=%llu\n", (unsigned long long)liveRecentReuseCount, (unsigned long long)liveAbsentReuseCount);
+		liveLookupCount = liveReuseCount = 0;
+		liveRecentReuseCount = liveAbsentReuseCount = 0;
+	}
+	// ResourceInfo pointers remain stable across unordered_map rehash, but not
+	// across the encoder's used.clear(). Never carry them into another encoder.
+	for (auto& recent : recentLiveResources) recent = {};
+	for (id<MTLResource> resource : retainedLiveResources) [resource release];
+	retainedLiveResources.clear();
+}
+
+void MVKUseResourceHelper::releasePendingBatchLiveResources() {
+	for (id<MTLResource> resource : pendingBatchLiveResources) [resource release];
+	pendingBatchLiveResources.clear();
