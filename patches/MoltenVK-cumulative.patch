+template<class AddFunctions>
+static id<MTLBinaryArchive> mvkPrepareBinaryArchive(MVKBinaryArchiveState& state,
+												 id<MTLDevice> mtlDev,
+												 id descriptor,
+												 bool isAMD,
+												 const char* pathEnvironment,
+												 AddFunctions addFunctions) {
+	if (!isAMD) { return nil; }
