--- a/MoltenVK/MoltenVK/Commands/MVKHeapUseCounter.h	1969-12-31 16:00:00
+++ b/MoltenVK/MoltenVK/Commands/MVKHeapUseCounter.h	2026-10-20 18:55:36
@@ -0,0 +1,40 @@
+// Scratch heap counts for resource-use batching. Small groups avoid one hash
+// allocation per heap per draw; larger groups retain linear expected work.
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <unordered_map>
+#include <utility>
+
+template<class Heap> class MVKHeapUseCounter {
+    static constexpr std::size_t inlineCapacity = 8;
+    std::array<std::pair<Heap, uint32_t>, inlineCapacity> small{};
+    std::size_t size = 0;
+    bool spilled = false;
+    std::unordered_map<Heap, uint32_t> large;
+public:
+    void add(Heap heap) {
+        if (spilled) { ++large[heap]; return; }
+        for (std::size_t i = 0; i < size; ++i) {
+            if (small[i].first == heap) { ++small[i].second; return; }
+        }
+        if (size < inlineCapacity) { small[size++] = {heap, 1}; return; }
+        large.reserve(inlineCapacity * 2);
+        for (std::size_t i = 0; i < size; ++i) large.emplace(small[i]);
+        spilled = true;
+        ++large[heap];
+    }
+    uint32_t count(Heap heap) const {
+        if (spilled) {
+            auto it = large.find(heap);
+            return it == large.end() ? 0 : it->second;
+        }
+        for (std::size_t i = 0; i < size; ++i) if (small[i].first == heap) return small[i].second;
+        return 0;
+    }
+    template<class F> void each(F&& fn) const {
+        if (spilled) { for (const auto& pair : large) fn(pair.first, pair.second); }
+        else { for (std::size_t i = 0; i < size; ++i) fn(small[i].first, small[i].second); }
+    }
+};
diff -ruN --exclude=include --exclude=SPIRV-Cross --exclude=SPIRV-Tools --exclude=Tools /tmp/mvk-upstream-patchcheck/MoltenVK-05604465d691118cfd20f53a48ecf1aad9c12f93/MoltenVK/MoltenVK/Commands/MVKHeapUseTable.h workspace/open-game-stack-20261015/native-vendor/MoltenVK-05604465d691118cfd20f53a48ecf1aad9c12f93/MoltenVK/MoltenVK/Commands/MVKHeapUseTable.h
--- a/MoltenVK/MoltenVK/Commands/MVKHeapUseTable.h	1969-12-31 16:00:00
+++ b/MoltenVK/MoltenVK/Commands/MVKHeapUseTable.h	2026-10-20 23:38:09
@@ -0,0 +1,54 @@
+// Reusable CPU scratch table. Never owns or dereferences heap identities.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <vector>
+
+template<class Heap> class MVKHeapUseTable {
+    struct Slot { Heap heap{}; uint32_t count = 0; };
+    std::vector<Slot> slots;
+    std::size_t used = 0;
+    static std::size_t hash(Heap heap) {
+        // Mix aligned Metal pointers before applying a power-of-two mask.
+        uint64_t x = std::hash<Heap>{}(heap);
+        x ^= x >> 30; x *= UINT64_C(0xbf58476d1ce4e5b9);
+        x ^= x >> 27; x *= UINT64_C(0x94d049bb133111eb);
+        return x ^ (x >> 31);
+    }
+    void grow() {
+        std::vector<Slot> old;
+        old.swap(slots);
+        slots.resize(old.empty() ? 16 : old.size() * 2);
+        used = 0;
+        for (auto& s : old) if (s.count) insert(s.heap, s.count);
+    }
+    void insert(Heap heap, uint32_t count) {
+        auto i = hash(heap) & (slots.size() - 1);
+        while (slots[i].count && slots[i].heap != heap) i = (i + 1) & (slots.size() - 1);
+        if (!slots[i].count) { slots[i].heap = heap; ++used; }
+        slots[i].count += count;
+    }
+public:
+    void reset() {
+        // Resource declarations never survive this reset, only scratch capacity.
+        for (auto& s : slots) s.count = 0;
+        used = 0;
+    }
+    void add(Heap heap) {
+        if (slots.empty() || (used + 1) * 2 > slots.size()) grow();
+        insert(heap, 1);
+    }
+    uint32_t count(Heap heap) const {
+        if (slots.empty()) return 0;
+        auto i = hash(heap) & (slots.size() - 1);
+        while (slots[i].count) {
+            if (slots[i].heap == heap) return slots[i].count;
+            i = (i + 1) & (slots.size() - 1);
+        }
+        return 0;
+    }
+    template<class F> void each(F&& fn) const {
+        for (auto& s : slots) if (s.count) fn(s.heap, s.count);
+    }
+};
