+bool CompilerMSL::amd_coherent_scalar32_access(uint32_t pointer)
+{
+	if (!msl_options.coherent_buffer_atomics || !msl_options.supports_msl_version(3, 2))
+		return false;
+	const auto &type = expression_type(pointer);
+	// Physical pointers can promise less than 4-byte alignment. Do not strengthen those accesses.
+	if (type.storage != StorageClassStorageBuffer && type.storage != StorageClassUniform)
+		return false;
+	if (type.width != 32 || type.vecsize != 1 || type.columns != 1 || !type.array.empty() ||
+	    (type.basetype != SPIRType::UInt && type.basetype != SPIRType::Int) ||
+	    has_extended_decoration(pointer, SPIRVCrossDecorationPhysicalTypeID))
+		return false;
+	auto *var = maybe_get_backing_variable(pointer);
+	return var && get_variable_address_space(*var).find("coherent device") != string::npos;
