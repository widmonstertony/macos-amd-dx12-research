+// The vertex shader (object stage) and the geometry shader (mesh stage) of a geometry pipeline are
+// compiled separately, so the vertices they exchange through the payload use a layout that depends
+// on neither shader's interface: position, point size, clip/cull distances, and one uint4 per
+// location holding the bits of each component. Vertex outputs are stored by location and component,
+// geometry inputs are loaded by location and component, so a geometry shader may read any subset of
+// the vertex outputs, with any types, and gl_in[] blocks work.
+static const uint32_t kMeshPayloadLocations = 32;
+static const uint32_t kMeshPayloadClipCullDistances = 8;
+
+void CompilerMSL::emit_mesh_payload_vertex_struct()
+{
+	statement("struct spvGSVertex");
+	begin_scope();
+	statement("float4 position;");
+	statement("float pointSize;");
+	statement("float clipDistance[", kMeshPayloadClipCullDistances, "];");
+	statement("float cullDistance[", kMeshPayloadClipCullDistances, "];");
+	statement("uint4 locations[", kMeshPayloadLocations, "];");
+	end_scope_decl();
+	statement("");
+}
+
+uint32_t CompilerMSL::mesh_payload_location_slots(const SPIRType &type)
+{
+	if (!type.array.empty())
+		return to_array_size_literal(type) * mesh_payload_location_slots(get<SPIRType>(type.parent_type));
+	if (type.basetype == SPIRType::Struct)
+	{
+		uint32_t slots = 0;
+		for (auto &mbr : type.member_types)
+			slots += mesh_payload_location_slots(get<SPIRType>(mbr));
+		return slots;
+	}
+	return type.columns;
+}
+
+static const char *mesh_payload_to_bits(SPIRType::BaseType basetype, const std::string &v, std::string &out)
+{
+	switch (basetype)
+	{
+	case SPIRType::Float: out = "as_type<uint>(" + v + ")"; break;
+	case SPIRType::Half: out = "uint(as_type<ushort>(" + v + "))"; break;
+	case SPIRType::Int: out = "as_type<uint>(" + v + ")"; break;
+	case SPIRType::UInt: out = "uint(" + v + ")"; break;
+	case SPIRType::Short: out = "uint(as_type<ushort>(" + v + "))"; break;
+	case SPIRType::UShort: out = "uint(" + v + ")"; break;
+	case SPIRType::SByte: out = "uint(as_type<uchar>(" + v + "))"; break;
+	case SPIRType::UByte: out = "uint(" + v + ")"; break;
+	case SPIRType::Boolean: out = "uint(" + v + ")"; break;
+	default: return "Unsupported vertex output type in a geometry pipeline.";
+	}
+	return nullptr;
+}
+
+static const char *mesh_payload_from_bits(SPIRType::BaseType basetype, const std::string &u, std::string &out)
+{
+	switch (basetype)
+	{
+	case SPIRType::Float: out = "as_type<float>(" + u + ")"; break;
+	case SPIRType::Half: out = "as_type<half>(ushort(" + u + "))"; break;
+	case SPIRType::Int: out = "as_type<int>(" + u + ")"; break;
+	case SPIRType::UInt: out = u; break;
+	case SPIRType::Short: out = "as_type<short>(ushort(" + u + "))"; break;
+	case SPIRType::UShort: out = "ushort(" + u + ")"; break;
+	case SPIRType::SByte: out = "as_type<char>(uchar(" + u + "))"; break;
+	case SPIRType::UByte: out = "uchar(" + u + ")"; break;
+	case SPIRType::Boolean: out = "(" + u + " != 0u)"; break;
+	default: return "Unsupported geometry shader input type.";
+	}
+	return nullptr;
+}
+
+void CompilerMSL::emit_mesh_payload_store(const SPIRType &type, const std::string &expr, uint32_t location,
+                                          uint32_t component)
+{
+	if (!type.array.empty())
+	{
+		auto &elem_type = get<SPIRType>(type.parent_type);
+		uint32_t elem_slots = mesh_payload_location_slots(elem_type);
+		for (uint32_t i = 0; i < to_array_size_literal(type); i++)
+			emit_mesh_payload_store(elem_type, join(expr, "[", i, "]"), location + i * elem_slots, component);
+		return;
+	}
+	if (type.basetype == SPIRType::Struct)
+		SPIRV_CROSS_THROW("Struct vertex outputs are not supported in a geometry pipeline.");
+	if (type.columns > 1)
+	{
+		auto col_type = type;
+		col_type.columns = 1;
+		for (uint32_t c = 0; c < type.columns; c++)
+			emit_mesh_payload_store(col_type, join(expr, "[", c, "]"), location + c, component);
+		return;
+	}
+	if (location >= kMeshPayloadLocations || component + type.vecsize > 4)
+		SPIRV_CROSS_THROW("Vertex output location out of range in a geometry pipeline.");
+	for (uint32_t k = 0; k < type.vecsize; k++)
+	{
+		string bits;
+		string v = type.vecsize == 1 ? expr : join(expr, ".", "xyzw"[k]);
+		if (const char *err = mesh_payload_to_bits(type.basetype, v, bits))
+			SPIRV_CROSS_THROW(err);
+		statement("payload.vertices[i].locations[", location, "][", component + k, "] = ", bits, ";");
+	}
+}
+
+string CompilerMSL::mesh_payload_load(const SPIRType &type, uint32_t location, uint32_t component)
+{
+	if (location >= kMeshPayloadLocations || component + type.vecsize > 4)
+		SPIRV_CROSS_THROW("Geometry shader input location out of range.");
+	string comps;
+	for (uint32_t k = 0; k < type.vecsize; k++)
+	{
+		string v;
+		if (const char *err = mesh_payload_from_bits(type.basetype,
+		                                            join("vtx.locations[", location, "][", component + k, "]"), v))
+			SPIRV_CROSS_THROW(err);
+		comps += (k ? ", " : "") + v;
+	}
+	auto scalar_type = type;
+	scalar_type.vecsize = 1;
+	scalar_type.columns = 1;
+	return type.vecsize == 1 ? comps : join(type_to_glsl(type), "(", comps, ")");
+}
+
+void CompilerMSL::emit_mesh_payload_load(const SPIRType &type, const std::string &lhs, uint32_t location,
+                                         uint32_t component)
+{
+	if (!type.array.empty())
+	{
+		auto &elem_type = get<SPIRType>(type.parent_type);
+		uint32_t elem_slots = mesh_payload_location_slots(elem_type);
+		for (uint32_t i = 0; i < to_array_size_literal(type); i++)
+			emit_mesh_payload_load(elem_type, join(lhs, "[", i, "]"), location + i * elem_slots, component);
+		return;
+	}
+	if (type.basetype == SPIRType::Struct)
+	{
+		uint32_t loc = location;
+		for (uint32_t m = 0; m < uint32_t(type.member_types.size()); m++)
+		{
+			auto &mbr_type = get<SPIRType>(type.member_types[m]);
+			if (has_member_decoration(type.self, m, DecorationLocation))
+				loc = get_member_decoration(type.self, m, DecorationLocation);
+			uint32_t comp = get_member_decoration(type.self, m, DecorationComponent);
+			emit_mesh_payload_load(mbr_type, join(lhs, ".", to_member_name(type, m)), loc, comp);
+			loc += mesh_payload_location_slots(mbr_type);
+		}
+		return;
+	}
+	if (type.columns > 1)
+	{
+		auto col_type = type;
+		col_type.columns = 1;
+		for (uint32_t c = 0; c < type.columns; c++)
+			statement(lhs, "[", c, "] = ", mesh_payload_load(col_type, location + c, component), ";");
+		return;
+	}
+	statement(lhs, " = ", mesh_payload_load(type, location, component), ";");
+}
+
+// Transform feedback of an emulated geometry shader: the transform feedback buffers the geometry shader
+// writes, and their strides.
+void CompilerMSL::collect_mesh_xfb_buffers()
+{
+	mesh_xfb_used_mask = 0;
+	ir.for_each_typed_id<SPIRVariable>([&](uint32_t, SPIRVariable &var) {
+		if (var.storage != StorageClassOutput || !interface_variable_exists_in_entry_point(var.self))
+			return;
+		if (!has_decoration(var.self, DecorationXfbBuffer))
+			return;
+		uint32_t buffer = get_decoration(var.self, DecorationXfbBuffer);
+		if (buffer >= 4)
+			SPIRV_CROSS_THROW("Transform feedback buffer index out of range.");
+		auto &type = get_variable_data_type(var);
+		bool captured = has_decoration(var.self, DecorationOffset);
+		if (type.basetype == SPIRType::Struct)
+			for (uint32_t m = 0; m < uint32_t(type.member_types.size()); m++)
+				captured = captured || has_member_decoration(type.self, m, DecorationOffset);
+		if (!captured)
+			return;
+		mesh_xfb_used_mask |= 1u << buffer;
+		mesh_xfb_strides[buffer] = get_decoration(var.self, DecorationXfbStride);
+	});
+}
+
+// Stores one captured output of the vertex v into the transform feedback buffer at the vertex slot s.
+void CompilerMSL::emit_mesh_xfb_store(const SPIRType &type, const std::string &expr, uint32_t buffer, uint32_t offset)
+{
+	if (!type.array.empty())
+	{
+		auto &elem_type = get<SPIRType>(type.parent_type);
+		uint32_t elem_size = elem_type.vecsize * elem_type.columns * 4;
+		for (uint32_t i = 0; i < to_array_size_literal(type); i++)
+			emit_mesh_xfb_store(elem_type, join(expr, "[", i, "]"), buffer, offset + i * elem_size);
+		return;
+	}
+	if (type.columns > 1)
+	{
+		auto col_type = type;
+		col_type.columns = 1;
+		for (uint32_t c = 0; c < type.columns; c++)
+			emit_mesh_xfb_store(col_type, join(expr, "[", c, "]"), buffer, offset + c * type.vecsize * 4);
+		return;
+	}
+	if (type.width != 32 || (type.basetype != SPIRType::Float && type.basetype != SPIRType::Int &&
+	                         type.basetype != SPIRType::UInt))
+		SPIRV_CROSS_THROW("Transform feedback of this output type is not supported.");
+	string t = type_to_glsl(type);
+	if (type.vecsize > 1)
+		t = "packed_" + t;
+	// Outputs to a transform feedback buffer that is not bound are ignored.
+	statement("if (xfb.buffers[", buffer, "]) *(device ", t, " *)(xfb.buffers[", buffer, "] + s * ", mesh_xfb_strides[buffer],
+	          " + ", offset, ") = ", t, "(", expr, ");");
+}
+
+// The capture function of the mesh stream: stores the captured outputs of a vertex at its slot.
+void CompilerMSL::emit_mesh_xfb_capture_function(const std::string &vertex_type)
+{
+	auto &out_type = get_variable_data_type(get<SPIRVariable>(stage_out_var_id));
+	statement("static inline void spvXfbCapture(thread spvXfbContext &xfb, thread const ", vertex_type, " &v)");
+	begin_scope();
+	statement("if (xfb.mode == 2 && xfb.slot != 0xffffffffu)");
+	begin_scope();
+	statement("uint s = xfb.slot + xfb.count;");
+	for (uint32_t m = 0; m < uint32_t(out_type.member_types.size()); m++)
+	{
+		if (!has_extended_member_decoration(out_type.self, m, SPIRVCrossDecorationInterfaceOrigID))
+			continue;
+		uint32_t var_id = get_extended_member_decoration(out_type.self, m, SPIRVCrossDecorationInterfaceOrigID);
+		auto *var = maybe_get<SPIRVariable>(var_id);
+		if (!var || !has_decoration(var_id, DecorationXfbBuffer))
+			continue;
+		uint32_t buffer = get_decoration(var_id, DecorationXfbBuffer);
+		auto &var_type = get_variable_data_type(*var);
+		bool has_offset = false;
+		uint32_t offset = 0;
+		if (var_type.basetype == SPIRType::Struct)
+		{
+			uint32_t var_mbr = get_extended_member_decoration(out_type.self, m, SPIRVCrossDecorationInterfaceMemberIndex);
+			if (has_member_decoration(var_type.self, var_mbr, DecorationOffset))
+			{
+				has_offset = true;
+				offset = get_member_decoration(var_type.self, var_mbr, DecorationOffset);
+			}
+		}
+		else if (has_decoration(var_id, DecorationOffset))
+		{
+			has_offset = true;
+			offset = get_decoration(var_id, DecorationOffset);
+		}
+		if (!has_offset)
+			continue;
+		emit_mesh_xfb_store(get<SPIRType>(out_type.member_types[m]), join("v.", to_member_name(out_type, m)), buffer, offset);
+	}
+	end_scope();
+	statement("xfb.count++;");
+	end_scope();
+	statement("");
+}
