+// Returns the argument(s) a mesh-pipeline wrapper entry point passes to the wrapped stage function
+// for an entry point resource. Arrays of buffers are declared as one argument per element
+// (name_0, name_1, ...) by entry_point_args_discrete_descriptors(), so they are passed that way.
+string CompilerMSL::mesh_wrapper_resource_arg(const Entry_Point_Resource &resource)
+{
+	if (resource.basetype == SPIRType::Struct && resource.var)
+	{
+		auto &type = get_variable_data_type(*resource.var);
+		if (!type.array.empty() && !ir.meta[type.self].members.empty())
+		{
+			uint32_t array_size = get_resource_array_size(type, resource.var->self);
+			string args;
+			for (uint32_t i = 0; i < array_size; i++)
+				args += join(i ? ", " : "", resource.name, "_", i);
+			return args;
+		}
+	}
+	return resource.name;
+}
