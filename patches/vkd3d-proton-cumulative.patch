+                m.State != MEM_COMMIT || (m.Protect & (PAGE_NOACCESS | PAGE_GUARD)) ||
+                (ULONG_PTR)ptr < (ULONG_PTR)m.BaseAddress ||
+                (ULONG_PTR)ptr + count * unit > (ULONG_PTR)m.BaseAddress + m.RegionSize)
+            return EXCEPTION_CONTINUE_SEARCH;
+        if (unit == sizeof(WCHAR))
+        {
+            int n = WideCharToMultiByte(CP_UTF8, 0, ptr, (int)count, text, sizeof(text)-1, NULL, NULL);
+            if (n <= 0) return EXCEPTION_CONTINUE_SEARCH;
+            text[n] = 0;
+        }
+        else { memcpy(text, ptr, count); text[count] = 0; }
+        for (i = 0; text[i] && i < sizeof(lower)-1; i++)
+            lower[i] = text[i] >= 'A' && text[i] <= 'Z' ? text[i] + ('a'-'A') : text[i];
+        lower[i] = 0;
+        if ((strstr(lower, "fatal") || strstr(lower, "error") || strstr(lower, "d3d") ||
+                strstr(lower, "dxgi") || strstr(lower, "shader") || strstr(lower, "rhi")) &&
+                InterlockedIncrement(&research_observer_records) <= 64)
