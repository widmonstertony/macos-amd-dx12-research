+static std::unique_lock<std::mutex> invalidateDescriptorUseCache(
+    const MVKDescriptorSet* set, const MVKDescriptorBinding* binding, uint32_t start, uint32_t count) {
+    if (!set->resourceUseCache) return {};
+    uint32_t available = binding->isVariable() ? set->variableDescriptorCount : binding->descriptorCount;
+    size_t stride = descriptorCPUSize(binding->cpuLayout);
+    if (stride && start <= available && count <= available-start)
+        return set->resourceUseCache->beginWrite(set->cpuBuffer + binding->cpuOffset + start*stride, count*stride);
+    // Cross-binding writes fall back to conservative invalidation.
+    return set->resourceUseCache->beginWrite();
+}
