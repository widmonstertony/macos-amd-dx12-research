--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -244,6 +244,40 @@
 void release_win_data(struct macdrv_win_data *data)
 {
     if (data) pthread_mutex_unlock(&win_data_mutex);
+}
+
+/* win32u invokes client surface update/present with surfaces_lock held.
+ * A window owner can reenter message processing while retaining win_data_mutex.
+ * Waiting for its window lock here then inverts its window -> surface order.
+ * Defer the view operation instead: the window-owner update or a later present
+ * retries it. The caller still holds surfaces_lock, retaining surface lifetime.
+ * Never use this helper for window creation/destruction or other mandatory work.
+ */
+static struct macdrv_win_data *get_surface_win_data(HWND hwnd)
+{
+    struct macdrv_win_data *data;
+    static LONG deferred_count;
+    static LONG blocking_count;
+    const char *blocking = getenv("WINE_MACDRV_TEST_BLOCKING_SURFACES");
+
+    /* Isolated regression control, never enabled in the deployed configuration. */
+    if (blocking && !strcmp(blocking, "1"))
+    {
+        if (InterlockedIncrement(&blocking_count) == 1)
+            fprintf(stderr, "macdrv-lockfix: blocking regression control enabled\n");
+        return get_win_data(hwnd);
+    }
+    if (!hwnd) return NULL;
+    if (pthread_mutex_trylock(&win_data_mutex))
+    {
+        if (InterlockedIncrement(&deferred_count) == 1 && getenv("WINE_MACDRV_LOCK_DIAGNOSTICS"))
+            fprintf(stderr, "macdrv-lockfix: deferred surface window update under contention\n");
+        return NULL;
+    }
+    if (win_datas && (data = (struct macdrv_win_data *)CFDictionaryGetValue(win_datas, hwnd)))
+        return data;
+    pthread_mutex_unlock(&win_data_mutex);
+    return NULL;
 }
 
 
