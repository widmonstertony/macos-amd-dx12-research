@@ -244,6 +245,30 @@
 void release_win_data(struct macdrv_win_data *data)
 {
     if (data) pthread_mutex_unlock(&win_data_mutex);
+}
+
+/* win32u calls these surface callbacks while holding surfaces_lock. Never wait
+ * here on a window lock retained by its owner during reentrant window updates:
+ * that owner may itself need surfaces_lock. Defer only the view operation and
+ * let the owner update or next present retry. surfaces_lock still protects the
+ * surface's lifetime. Mandatory window operations retain their blocking locks.
+ */
+static struct macdrv_win_data *get_surface_win_data(HWND hwnd)
+{
+    struct macdrv_win_data *data;
+    static LONG deferred_count;
+
+    if (!hwnd) return NULL;
+    if (pthread_mutex_trylock(&win_data_mutex))
+    {
+        if (InterlockedIncrement(&deferred_count) == 1 && getenv("WINE_MACDRV_LOCK_DIAGNOSTICS"))
+            fprintf(stderr, "macdrv-lockfix: deferred surface window update under contention\n");
+        return NULL;
+    }
+    if (win_datas && (data = (struct macdrv_win_data *)CFDictionaryGetValue(win_datas, hwnd)))
+        return data;
+    pthread_mutex_unlock(&win_data_mutex);
+    return NULL;
 }
 
 
