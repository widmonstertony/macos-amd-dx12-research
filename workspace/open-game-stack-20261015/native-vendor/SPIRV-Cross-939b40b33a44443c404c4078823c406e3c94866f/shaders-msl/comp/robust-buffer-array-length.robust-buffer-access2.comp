#version 450
layout(local_size_x = 1) in;

layout(set = 0, binding = 0, std430) buffer SSBO
{
    uint size_result;
    uint data[];
};

layout(set = 0, binding = 1, std430) buffer SSBO2
{
    uint read_result;
};

void main()
{
    // Test OpArrayLength with non-zero offset
    // With robustBufferAccess2, if buffer_size < offset, should return 0
    // This handles null descriptors where buffer_size may be 0
    size_result = data.length();

    // Only access if there's at least one element
    if (size_result > 0u)
    {
        read_result = data[0];
    }
    else
    {
        read_result = 0u;
    }
}
