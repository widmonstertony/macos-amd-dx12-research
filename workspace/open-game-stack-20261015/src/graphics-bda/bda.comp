#version 450
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=32) in;
layout(buffer_reference,std430,buffer_reference_align=4) buffer Physical { uint v[]; };
layout(set=0,binding=0,std430) readonly buffer Cases { ivec4 v[]; } cases;
layout(set=0,binding=1,std430) buffer Results { uvec4 v[]; } results;
layout(set=0,binding=2,std430) readonly buffer Logical { uint v[]; } logical;
layout(set=0,binding=3,std430) readonly buffer Addresses { Physical refs[2]; } addresses;
layout(push_constant) uniform Config { uint64_t a; uint64_t b; uint count; } config;
void main(){
 uint id=gl_GlobalInvocationID.x;if(id>=config.count)return;
 ivec4 c=cases.v[id];uvec4 value=uvec4(0);
 Physical a=Physical(config.a), b=Physical(config.b);
 if(c.x==0)value.x=a.v[c.y];
 else if(c.x==1)value.x=b.v[c.y];
 else if(c.x==2){a.v[c.y]=uint(c.z);value.x=1;}
 else if(c.x==3)value.x=atomicAdd(b.v[c.y],uint(c.z));
 else if(c.x==4)value.x=logical.v[c.y];
 else if(c.x==5){Physical p=addresses.refs[c.z];value.x=uint64_t(p)==0?0:p.v[c.y];}
 else if(c.x==6){Physical p=Physical(config.a+uint64_t(uint(c.y))*4ul);value.x=p.v[0];}
 else if(c.x==7){uint64_t p=uint64_t(a);value=uvec4(uint(p),uint(p>>32),0,0);}
 results.v[id]=value;
}
