#version 450
#extension GL_EXT_nonuniform_qualifier : require
layout(local_size_x=32) in;
#ifdef RUNTIME_DESCRIPTORS
layout(set=0,binding=8,std430) buffer Data { uint v[]; } data[];
#else
layout(set=0,binding=8,std430) buffer Data { uint v[]; } data[3];
#endif
layout(set=0,binding=1,std430) readonly buffer Cases { ivec4 v[]; } cases;
layout(set=0,binding=2,std430) buffer Results { uint v[]; } results;
layout(push_constant) uniform Config { uint count; } config;
void main() {
    uint id=gl_GlobalInvocationID.x;
    if(id>=config.count)return;
    ivec4 c=cases.v[id];
    uint d=nonuniformEXT(c.x);
    if(c.z==0)results.v[id]=data[d].v[c.y];
    else if(c.z==1){data[d].v[c.y]=uint(c.w);results.v[id]=1;}
    else if(c.z==2)results.v[id]=atomicAdd(data[d].v[c.y],uint(c.w));
    else results.v[id]=data[d].v.length();
}
