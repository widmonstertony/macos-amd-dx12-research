#version 450
layout(local_size_x=1) in;
layout(set=0,binding=0,std140) uniform UniformBlock {
    uint tag; uvec3 packed; mat3x4 cm; layout(row_major) mat3x4 rm; uvec4 fixedV[3];
} u;
layout(set=0,binding=1,std430) buffer StorageBlock {
    uint tag; uvec3 packed; mat3x4 cm; layout(row_major) mat3x4 rm; uvec4 fixedV[3];
} b;
layout(set=0,binding=2,std430) buffer Result { uvec4 v[]; } dst;
layout(push_constant) uniform Params { uint operation,index; } pc;
void main(){
    uvec4 answer[4];for(uint i=0;i<4;i++)answer[i]=uvec4(0);
    if(pc.operation==0)answer[0].x=u.tag;
    else if(pc.operation==1)answer[0]=uvec4(u.packed,0);
    else if(pc.operation==2){mat3x4 m=u.cm;for(uint c=0;c<3;c++)answer[c]=floatBitsToUint(m[c]);}
    else if(pc.operation==3){mat3x4 m=u.rm;for(uint c=0;c<3;c++)answer[c]=floatBitsToUint(m[c]);}
    else if(pc.operation==4)answer[0]=u.fixedV[pc.index];
    else if(pc.operation==5)b.tag=777;
    else if(pc.operation==6)b.packed=uvec3(778,779,780);
    else if(pc.operation==7)b.cm=mat3x4(vec4(13,14,15,16),vec4(17,18,19,20),vec4(21,22,23,24));
    else if(pc.operation==8)b.rm=mat3x4(vec4(1,2,3,4),vec4(5,6,7,8),vec4(9,10,11,12));
    else if(pc.operation==9)b.fixedV[pc.index]=uvec4(900,901,902,903);
    else if(pc.operation==10)answer[0].x=atomicAdd(b.tag,1);
    else if(pc.operation==11)answer[0].x=u.fixedV[pc.index].y;
    else if(pc.operation==12)b.fixedV[pc.index].y=999;
    for(uint i=0;i<4;i++)dst.v[i]=answer[i];
}
