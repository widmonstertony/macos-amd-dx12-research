#version 450
layout(local_size_x=32) in;
layout(set=0,binding=0,std430) buffer Data { uint v[]; } data;
layout(set=0,binding=1,std140) uniform UniformData { uvec4 v[2]; } uniforms;
layout(set=0,binding=2,std430) readonly buffer Cases { ivec4 v[]; } cases;
layout(set=0,binding=3,std430) buffer Results { uvec4 v[]; } results;
layout(push_constant) uniform Config { uint count; } config;
void main(){
 uint id=gl_GlobalInvocationID.x;if(id>=config.count)return;
 ivec4 c=cases.v[id];uvec4 value=uvec4(0);
 if(c.x==0)value.x=data.v[c.y];
 else if(c.x==1)value=uniforms.v[c.y];
 else if(c.x==2){data.v[c.y]=uint(c.z);value.x=1;}
 else if(c.x==3)value.x=data.v.length();
 else if(c.x==4)value.x=atomicExchange(data.v[c.y],uint(c.z));
 else if(c.x==5)value.x=atomicCompSwap(data.v[c.y],uint(c.z),uint(c.w));
 else if(c.x==6)value.x=atomicMin(data.v[c.y],uint(c.z));
 else if(c.x==7)value.x=atomicMax(data.v[c.y],uint(c.z));
 else if(c.x==8)value.x=atomicAnd(data.v[c.y],uint(c.z));
 else if(c.x==9)value.x=atomicOr(data.v[c.y],uint(c.z));
 else if(c.x==10)value.x=atomicXor(data.v[c.y],uint(c.z));
 results.v[id]=value;
}
